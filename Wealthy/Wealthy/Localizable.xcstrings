    },
    "estimateDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compares 10% and 8% tax portions of the same tax-inclusive dine-in food amount. It is not a guaranteed discount."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "店内で食べた食品の同じ税込金額について、10%と8%の税額部分を比較します。実際の値引きを保証するものではありません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara las partes de impuesto al 10% y al 8% del mismo importe con impuesto incluido. No garantiza un descuento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 매장 음식의 세금 포함 금액에서 10%와 8% 세금 부분을 비교합니다. 실제 할인을 보장하지 않습니다."
          }
        }
      }
    },
    "lateDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Results are recalculated from your records. Forgotten days can be added within three days after the period ends."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果は記録から再計算します。期間終了後3日以内は忘れた日を追加できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados se recalculan con tus registros. Puedes añadir días olvidados hasta tres días después del período."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과는 기록으로 다시 계산됩니다. 기간 종료 후 3일 이내에 누락된 날을 추가할 수 있습니다."
          }
        }
      }
    },
