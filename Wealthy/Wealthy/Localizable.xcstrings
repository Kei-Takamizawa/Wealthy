    "aboutDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wealthy helps you track household and child spending against monthly targets."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wealthyは家計と子どもの支出を月の目標と比べて確認できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
