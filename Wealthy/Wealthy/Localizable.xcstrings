          }
        }
      }
    },
    "taxDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes fixed costs. Tax-exempt entries add no tax. Per-entry estimates may differ from invoice rounding."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定費を含みます。非課税の記録には税額を加算しません。記録ごとの概算は請求書の端数処理と異なる場合があります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye gastos fijos. Los registros exentos no añaden impuesto. La estimación por registro puede diferir del redondeo de la factura."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정비가 포함됩니다. 면세 기록은 세금이 없습니다. 기록별 추정치는 청구서 반올림과 다를 수 있습니다."
          }
        }
      }
    },
    "taxableBase": {
      "extractionState": "manual",
