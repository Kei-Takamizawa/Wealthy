    "goalsUnsetDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your previous target stays in effect until you set a new one. The island will start a new month when you set it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい目標を設定するまで、前の目標が適用されます。設定すると新しい月の島が始まります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El objetivo anterior sigue vigente hasta que fijes uno nuevo. Al hacerlo, comenzará un nuevo mes en la isla."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 목표를 설정할 때까지 이전 목표가 적용돼요. 목표를 설정하면 섬의 새 달이 시작돼요."
          }
        }
      }
