    "taxTotal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tax included this month"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
